generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MarketStatus {
  DRAFT
  PENDING_APPROVAL
  LIVE
  LOCKED
  RESOLVING
  RESOLVED
  DISPUTED
  CANCELLED
  ARCHIVED
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  UPHELD
  REJECTED
}

enum FraudFlagType {
  WASH_TRADING
  RAPID_FIRE
  VOLUME_SPIKE
}

enum FraudFlagStatus {
  OPEN
  DISMISSED
  CONFIRMED
}

enum ReferralStatus {
  PENDING
  COMPLETED
}

enum BroadcastStatus {
  SCHEDULED
  SENT
  CANCELLED
}

enum BroadcastTarget {
  ALL
  SPECIFIC_USER
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  username           String    @unique
  passwordHash       String
  avatarUrl          String?
  bio                String?
  reputationScore    Int       @default(0)
  trustScore         Float     @default(50)
  accuracyPercentage Float     @default(0)
  totalBalance       Decimal   @default(10000)
  investedBalance    Decimal   @default(0)
  level              Int       @default(1)
  xpPoints           Int       @default(0)
  isAdmin            Boolean   @default(false)
  isSuspended        Boolean   @default(false)
  suspendedAt        DateTime?
  suspendedReason    String?
  referralCode       String    @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  isEmailVerified    Boolean   @default(false)
  verificationCode   String?
  verificationCodeExpires DateTime?
  fullName                String?   @default("")
  phone                   String?   @default("")
  timezone                String?   @default("")
  country                 String?   @default("")
  kycStatus               String    @default("Unverified")
  themePreference         String    @default("dark")
  preferredCurrency       String    @default("INR")
  languagePreference      String    @default("English")
  recommendedLayout       String    @default("Default")
  emailNotifications      Boolean   @default(true)
  walletUpdates           Boolean   @default(true)
  marketResultAlerts      Boolean   @default(true)
  newMarketAnnouncements  Boolean   @default(true)
  lastLoginAt             DateTime? @default(now())

  markets            Market[]           @relation("MarketCreator")
  predictions        Prediction[]
  transactions       Transaction[]
  leaderboards       Leaderboard[]
  comments           Comment[]
  badges             BadgeEarned[]
  notifications      Notification[]
  followers          UserFollower[]     @relation("UserFollowers")
  following          UserFollower[]     @relation("UserFollowing")
  walletLedgers      WalletLedger[]
  positions          Position[]
  auditLogs          AuditLog[]         @relation("AdminAuditLogs")
  marketResolutions  MarketResolution[]
  disputesRaised     Dispute[]          @relation("DisputeRaiser")
  fraudFlags         FraudFlag[]
  referralsMade      Referral[]         @relation("Referrer")
  referredBy         Referral?          @relation("Referee")
  broadcastsCreated  NotificationBroadcast[] @relation("BroadcastCreator")

  @@index([trustScore])
}

model Market {
  id                 String       @id @default(uuid()) @db.Uuid
  title              String
  description        String
  category           String
  creatorId          String       @db.Uuid
  status             MarketStatus @default(DRAFT)
  resolutionDate     DateTime?
  resolvedDate       DateTime?
  resolutionCriteria String?
  imageUrl           String?
  totalVolume        Decimal      @default(0)
  yesPercentage      Float        @default(50)
  noPercentage       Float        @default(50)
  totalPredictions   Int          @default(0)
  liquidityPool      Decimal      @default(0)
  liquidityParam     Decimal      @default(100)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  creator      User                 @relation("MarketCreator", fields: [creatorId], references: [id])
  options      MarketOption[]
  predictions  Prediction[]
  transactions Transaction[]
  comments     Comment[]
  positions    Position[]
  priceHistory MarketPriceHistory[]
  analytics    MarketAnalytics[]
  resolution   MarketResolution?
  disputes     Dispute[]
  fraudFlags   FraudFlag[]

  @@index([status, category])
}

model WalletLedger {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  type          String // CREDIT or DEBIT
  subType       String? // e.g., PREDICTION_STAKE, PAYOUT, REFUND
  amount        Decimal
  balanceBefore Decimal
  balanceAfter  Decimal
  referenceId   String? // e.g., predictionId, transactionId
  metadata      Json?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Position {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  marketId     String         @db.Uuid
  optionId     String         @db.Uuid
  shares       Decimal
  costBasis    Decimal        @default(0)
  entryPrice   Float
  currentPrice Float?
  pnl          Decimal?       @default(0)
  status       PositionStatus @default(OPEN)
  createdAt    DateTime       @default(now())
  closedAt     DateTime?

  user   User         @relation(fields: [userId], references: [id])
  market Market       @relation(fields: [marketId], references: [id])
  option MarketOption @relation(fields: [optionId], references: [id])

  @@index([userId, status])
  @@index([marketId, optionId])
}

model MarketPriceHistory {
  id         String   @id @default(uuid()) @db.Uuid
  marketId   String   @db.Uuid
  optionId   String?  @db.Uuid
  price      Decimal
  recordedAt DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id])

  @@index([marketId, recordedAt])
}

model MarketAnalytics {
  id           String   @id @default(uuid()) @db.Uuid
  marketId     String   @db.Uuid
  volume24h    Decimal  @default(0)
  volume7d     Decimal  @default(0)
  tradersCount Int      @default(0)
  liquidity    Decimal  @default(0)
  priceMove24h Float    @default(0)
  computedAt   DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id])

  @@index([marketId, computedAt])
}

model MarketOption {
  id              String   @id @default(uuid()) @db.Uuid
  marketId        String   @db.Uuid
  optionText      String
  totalStaked     Decimal  @default(0)
  currentOdds     Float?
  sharesOutstanding Decimal @default(0)
  predictionCount Int      @default(0)
  createdAt       DateTime @default(now())

  market      Market       @relation(fields: [marketId], references: [id])
  predictions Prediction[]
  positions   Position[]
}

model Prediction {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  marketId        String    @db.Uuid
  optionId        String    @db.Uuid
  amountStaked    Decimal
  potentialReturn Decimal?
  status          String
  roiPercentage   Float?
  lockedAt        DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User         @relation(fields: [userId], references: [id])
  market Market       @relation(fields: [marketId], references: [id])
  option MarketOption @relation(fields: [optionId], references: [id])

  @@index([userId])
  @@index([marketId, optionId, status])
}

model Transaction {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  type         String
  amount       Decimal
  reason       String?
  marketId     String?  @db.Uuid
  balanceAfter Decimal
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  market Market? @relation(fields: [marketId], references: [id])

  @@index([userId, createdAt])
}

model Leaderboard {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  leaderboardType   String
  rank              Int
  score             Decimal
  winRatePercentage Float?
  totalProfit       Decimal?
  totalPredictions  Int?
  computedAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, leaderboardType])
}

model Comment {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  marketId        String   @db.Uuid
  parentCommentId String?  @db.Uuid
  text            String
  likes           Int      @default(0)
  reactions       Json?
  pinned          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id])
  market  Market    @relation(fields: [marketId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([marketId])
}

model UserFollower {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  followerId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User @relation("UserFollowers", fields: [userId], references: [id])
  follower User @relation("UserFollowing", fields: [followerId], references: [id])

  @@unique([userId, followerId])
}

model Badge {
  id           String  @id @default(uuid()) @db.Uuid
  badgeType    String  @unique
  displayName  String
  description  String?
  iconUrl      String?
  criteriaJson Json?

  earned BadgeEarned[]
}

model BadgeEarned {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  badgeId  String   @db.Uuid
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationBroadcast {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  message        String
  target         BroadcastTarget @default(ALL)
  targetUserId   String?         @db.Uuid
  createdById    String          @db.Uuid
  scheduledFor   DateTime?
  sentAt         DateTime?
  status         BroadcastStatus @default(SCHEDULED)
  recipientCount Int             @default(0)
  createdAt      DateTime        @default(now())

  createdBy User @relation("BroadcastCreator", fields: [createdById], references: [id])

  @@index([status, scheduledFor])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @db.Uuid
  action     String
  entityType String
  entityId   String?  @db.Uuid
  changes    Json?
  createdAt  DateTime @default(now())

  admin User @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model MarketResolution {
  id               String   @id @default(uuid()) @db.Uuid
  marketId         String   @unique @db.Uuid
  sourceUrl        String
  evidenceUrl      String?
  notes            String
  resolvedByUserId String   @db.Uuid
  winningOptionId  String   @db.Uuid
  resolvedAt       DateTime @default(now())

  market     Market @relation(fields: [marketId], references: [id])
  resolvedBy User   @relation(fields: [resolvedByUserId], references: [id])
}

model Dispute {
  id             String        @id @default(uuid()) @db.Uuid
  marketId       String        @db.Uuid
  raisedByUserId String        @db.Uuid
  reason         String
  evidenceUrl    String?
  status         DisputeStatus @default(OPEN)
  adminNotes     String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  market   Market @relation(fields: [marketId], references: [id])
  raisedBy User   @relation("DisputeRaiser", fields: [raisedByUserId], references: [id])

  @@index([marketId, status])
}

model FraudFlag {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  marketId   String?         @db.Uuid
  type       FraudFlagType
  severity   Int             @default(1)
  details    Json?
  status     FraudFlagStatus @default(OPEN)
  createdAt  DateTime        @default(now())
  reviewedAt DateTime?

  user   User    @relation(fields: [userId], references: [id])
  market Market? @relation(fields: [marketId], references: [id])

  @@index([status])
  @@index([userId])
}

model Referral {
  id           String         @id @default(uuid()) @db.Uuid
  referrerId   String         @db.Uuid
  refereeId    String         @unique @db.Uuid
  code         String
  status       ReferralStatus @default(PENDING)
  rewardAmount Decimal?
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  referrer User @relation("Referrer", fields: [referrerId], references: [id])
  referee  User @relation("Referee", fields: [refereeId], references: [id])

  @@index([referrerId])
}
